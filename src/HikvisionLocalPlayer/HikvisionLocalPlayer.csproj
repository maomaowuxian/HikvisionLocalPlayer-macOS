<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <AssemblyName>HikvisionLocalPlayer</AssemblyName>
    <RootNamespace>HikvisionLocalPlayer</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/index.html" LogicalName="HikvisionLocalPlayer.Resources.index.html" />
    <EmbeddedResource Include="Resources/app.css" LogicalName="HikvisionLocalPlayer.Resources.app.css" />
    <EmbeddedResource Include="Resources/app.js" LogicalName="HikvisionLocalPlayer.Resources.app.js" />
    <EmbeddedResource Include="Resources/app-icon.svg" LogicalName="HikvisionLocalPlayer.Resources.app-icon.svg" />
    <EmbeddedResource Include="Resources/go2rtc" LogicalName="HikvisionLocalPlayer.Resources.go2rtc" />
    <EmbeddedResource Include="Resources/go2rtc-LICENSE" LogicalName="HikvisionLocalPlayer.Resources.go2rtc-LICENSE" />
  </ItemGroup>
</Project>
